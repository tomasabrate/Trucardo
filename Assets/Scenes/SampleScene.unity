  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=\"center\"><b><size=120%>CANTOS DE ENVIDO</size></b>\r\n<color=#8B1E1E>\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</color>\r\n<b><size=105%>ENVIDO</size></b>\r\n<size=90%>2 puntos</size>\r\n<color=#8B1E1E>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\r\n<b><size=105%>ENVIDO ENVIDO</size></b>\r\n<size=90%>3 puntos</size>\r\n<color=#8B1E1E>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\r\n<b><size=105%>REAL ENVIDO</size></b>\r\n<size=90%>4 puntos</size>\r\n<color=#8B1E1E>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color>\r\n<b><size=105%>FALTA ENVIDO</size></b>\r\n<size=90%>Se juegan todos los puntos faltantes suyos </size>\n<size=75%>(Si le faltase 6 se juega por 6 aunque</size>\n<size=75%>a su rival le falte un punto para ganar)</size>\r\n<color=#8B1E1E>\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501</color>\r\n</align>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d66b802d10305e84b8a05e2f8142f684, type: 2}
